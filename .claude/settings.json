{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(bun run check)",
      "Bash(bun run check:agents)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run typecheck)",
      "Bash(bun run dev:api)",
      "Bash(bun run infra:up)",
      "Bash(bunx biome *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(bun run infra:down:*)",
      "Bash(bun run osm:update:*)",
      "Bash(docker compose down:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
