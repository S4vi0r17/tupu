# Copiá este archivo a apps/api/.env. Bun lo carga solo al correr los scripts
# del API desde esta carpeta.
NODE_ENV=development
PORT=3000

# Postgres con PostGIS. El usuario y la clave los consume también infra/
DATABASE_URL=postgresql://tupu:tupu@localhost:5432/tupu

# Valhalla. NUNCA se expone a internet: solo lo alcanza el API (0009)
VALHALLA_URL=http://localhost:8002
