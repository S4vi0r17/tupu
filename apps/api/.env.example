# Copiá este archivo a apps/api/.env. Bun lo carga solo al correr los scripts
# del API desde esta carpeta.
NODE_ENV=development
# ! 3000 y 5432 suelen estar tomados por otras cosas en la máquina
PORT=3001

# Postgres con PostGIS. Este archivo es la fuente única del lado servidor:
# el compose de infra/ lo lee con --env-file, así que las credenciales de acá
# y las del contenedor no pueden quedar desalineadas.
POSTGRES_USER=tupu
POSTGRES_PASSWORD=tupu
POSTGRES_DB=tupu
POSTGRES_PORT=5433
DATABASE_URL=postgresql://tupu:tupu@localhost:5433/tupu

# Valhalla. NUNCA se expone a internet: solo lo alcanza el API (0009)
VALHALLA_URL=http://localhost:8002
