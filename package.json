{
  "name": "tupu",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "scripts": {
    "dev:api": "bun run --filter '@tupu/api' dev",
    "dev:mobile": "bun run --filter '@tupu/mobile' start",
    "db:migrate": "bun run --filter '@tupu/api' db:migrate",
    "infra:up": "docker compose --env-file apps/api/.env -f infra/compose.yaml up -d --wait postgis",
    "infra:down": "docker compose --env-file apps/api/.env -f infra/compose.yaml down",
    "osm:update": "infra/osm/update.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "typescript": "^5.9.3"
  }
}
