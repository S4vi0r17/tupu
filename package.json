{
  "name": "tupu",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev:api": "bun run --filter '@tupu/api' dev",
    "dev:mobile": "bun run --filter '@tupu/mobile' start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "typescript": "^5.9.3"
  }
}
